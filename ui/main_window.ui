<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>900</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>FitTrack</string>
  </property>
  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget, QScrollArea#pageScroll, QWidget#pageContent {
    background-color: #232323; color: #f5f5f5;
}
QWidget { font-family: &quot;Arial&quot;; font-size: 15px; color: #f5f5f5; }
QLabel { background: transparent; border: none; }
QLabel#titleLabel { font-size: 34px; font-weight: 700; }
QLabel#subtitleLabel { color: #b0b0b0; font-size: 18px; }
QFrame#searchFrame { background: #101010; border: 1px solid #343434; border-radius: 16px; }
QLineEdit#searchEdit { background: transparent; border: none; padding: 0; font-size: 19px; selection-background-color: #606060; }
QLineEdit#searchEdit:focus { border: none; }
QToolButton[categoryButton=&quot;true&quot;] { background: #101010; border: 1px solid #303030; border-radius: 16px; padding: 12px; font-size: 18px; }
QToolButton[categoryButton=&quot;true&quot;]:hover { background: #191919; border-color: #626262; }
QToolButton[categoryButton=&quot;true&quot;]:checked { background: #333333; border: 2px solid #e6e6e6; }
QToolButton[categoryButton=&quot;true&quot;]:focus { border-color: #e6e6e6; }
QFrame#separator { background: #383838; border: none; }
QLabel#sectionTitleLabel { font-size: 24px; font-weight: 700; }
QLabel#resultCountLabel { color: #a0a0a0; font-size: 13px; }
QPushButton#allExercisesButton { background: transparent; border: 1px solid #515151; border-radius: 10px; padding: 9px 14px; color: #dedede; font-size: 14px; }
QPushButton#allExercisesButton:hover { background: #343434; border-color: #999999; }
QFrame[thumbnail=&quot;true&quot;] { background: #161616; border: 1px solid #3b3b3b; border-radius: 17px; }
QLabel[photoCaption=&quot;true&quot;] { color: #898989; font-size: 11px; }
QLabel[exerciseTitle=&quot;true&quot;] { font-size: 22px; font-weight: 600; }
QLabel[exerciseMeta=&quot;true&quot;] { color: #b0b0b0; font-size: 16px; }
QLabel#emptyStateLabel { color: #b0b0b0; font-size: 17px; padding: 24px; background: #1b1b1b; border-radius: 14px; }
QLabel#footerLabel { color: #8d8d8d; font-size: 13px; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #232323; width: 8px; margin: 4px 1px; }
QScrollBar::handle:vertical { background: #555555; border-radius: 3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }</string>
  </property>
